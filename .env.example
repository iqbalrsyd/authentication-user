SECRET_KEY=replace-with-a-long-random-value
DEBUG=False
AUTH_DEMO_ENABLED=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Gmail SMTP. Use a Google App Password, not the normal account password.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=replace-with-16-character-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

OTP_EXPIRY_SECONDS=600
OTP_MAX_ATTEMPTS=5

# Google reCAPTCHA v2 checkbox keys.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_TIMEOUT_SECONDS=5
RECAPTCHA_ALLOWED_HOSTNAMES=localhost,127.0.0.1

# OAuth 2.0 Web Client ID from Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=
